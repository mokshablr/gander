<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Gander</string>
    <!-- About's opening line. It names the main kinds only, since the File types row below it
         lists every one. -->
    <string name="main_subtitle">Opens documents, spreadsheets, slides, photos, video, audio and more. Everything renders on your phone, nothing is uploaded.</string>
    <!-- The site's own h1, docs/index.html -->
    <string name="welcome_headline">Take a gander at any file.</string>
    <!-- The strongest sentence in the product, which used to be a clause in the middle of
         main_subtitle. The second half is checkable: the About dialog reads the permission
         list back out of Android rather than asserting it. -->
    <string name="welcome_promise">Nothing is uploaded. Gander has no internet permission.</string>
    <!-- Every kind Gander opens, the ones behind the ETC tile included, since a screen reader
         hears it in place of the first screen's tiles. FormatRegistryTest fails until a new
         kind is named here. -->
    <string name="what_it_opens">Opens PDFs, Word, OpenDocument and Rich Text documents, Excel spreadsheets, PowerPoint slides, images, video, audio, Markdown, text files, books, zips and 3D models.</string>
    <string name="open_a_file">Open a file</string>
    <string name="recent_files">Recent files</string>
    <string name="folders">Folders</string>
    <string name="add_folder">Add a folder</string>
    <string name="no_recents_hint">Files you open appear here for quick access.</string>
    <string name="no_folders_hint">Grant a folder to browse its files right here. Gander needs no storage permission to do it.</string>
    <string name="empty_folder">Nothing to show in this folder.</string>
    <!-- What the list of a .zip says in place of its contents. The second is a zip handed
         over as a stream rather than a file, which has to be read from the start and so
         cannot be looked inside; a saved copy is a file. -->
    <string name="archive_unreadable">Gander can\'t read this zip. It may be damaged, or not a zip at all.</string>
    <string name="archive_not_seekable">Gander can\'t look inside this zip from where it is. Save a copy from the menu and open that instead.</string>
    <string name="archive_too_large">This zip holds more files than Gander can list.</string>
    <!-- Beside a file in a zip that is listed and cannot be opened, and what tapping it says.
         A password-protected file opens with its password, and says why when it cannot: it is
         locked with PKWARE's Strong Encryption, which next to nothing writes. -->
    <string name="entry_locked">Password protected</string>
    <string name="entry_locked_unsupported">This file is locked in a way Gander can\'t unlock</string>
    <string name="entry_unsupported">Packed in a format Gander can\'t unpack</string>
    <string name="entry_unsupported_open">This file is packed in a way Gander can\'t read</string>
    <!-- Asking for a file's password, in the words the PDF viewer asks for a PDF's -->
    <string name="password_title">This file is password protected</string>
    <string name="password_message">Enter its password to open it.</string>
    <string name="password">Password</string>
    <string name="password_open">Open</string>
    <string name="password_wrong">That password did not work.</string>
    <!-- Choosing how a zip's names are read, when Gander's guess is wrong. Named by language
         first, since that is what a reader recognises, and by code page after it, which is
         what anyone who knows the term is looking for. -->
    <string name="name_encoding">File name encoding</string>
    <string name="name_encoding_automatic">Automatic</string>
    <string name="name_encoding_automatic_as">Automatic: %1$s</string>
    <string name="encoding_utf8">Unicode (UTF-8)</string>
    <string name="encoding_gbk">Chinese, Simplified (GBK)</string>
    <string name="encoding_big5">Chinese, Traditional (Big5)</string>
    <string name="encoding_sjis">Japanese (Shift_JIS)</string>
    <string name="encoding_korean">Korean (EUC-KR)</string>
    <string name="encoding_cp866">Cyrillic (DOS 866)</string>
    <string name="encoding_cp1251">Cyrillic (Windows 1251)</string>
    <string name="encoding_cp850">Western European (DOS 850)</string>
    <string name="encoding_cp437">English (DOS 437)</string>
    <string name="encoding_cp852">Central European (DOS 852)</string>
    <string name="encoding_cp737">Greek (DOS 737)</string>
    <string name="encoding_cp857">Turkish (DOS 857)</string>
    <string name="encoding_cp862">Hebrew (DOS 862)</string>
    <string name="encoding_cp720">Arabic (DOS 720)</string>
    <string name="encoding_cp874">Thai (874)</string>
    <string name="encoding_cp775">Baltic (DOS 775)</string>
    <string name="encoding_cp1258">Vietnamese (1258)</string>
    <string name="removed">Removed</string>
    <string name="undo">Undo</string>
    <!-- Removing a recent file or a folder gives back Gander's access to it, and Android has
         no way to re-take a released grant, so the reader would have to walk the system picker
         again. Hence a question first and an Undo after, issue #39. The row is swiped away
         over a bin, so each question says the thing itself stays where it is. -->
    <string name="remove_recent_title">Remove from recent files?</string>
    <string name="remove_recent_message">%1$s stays where it is, but Gander will lose access to it. Opening it again means finding it in the system picker.</string>
    <string name="remove_folder_title">Remove folder?</string>
    <string name="remove_folder_message">Nothing in %1$s is deleted, but Gander will lose access to it. Granting it back means finding it in the system picker again.</string>
    <!-- Also the TalkBack label for removing a row, which the swipe does -->
    <string name="remove">Remove</string>
    <string name="search_in_document">Search in document</string>
    <string name="share_file">Share</string>
    <string name="show_in_file_manager">Show in file manager</string>
    <string name="no_file_manager">No app can open this folder</string>
    <string name="share_failed">This file can\'t be shared</string>
    <string name="previous_match">Previous match</string>
    <string name="next_match">Next match</string>
    <string name="close_search">Close search</string>
    <string name="match_count">%1$d/%2$d</string>
    <!-- Spoken form: screen readers read "2/7" as "two sevenths" -->
    <string name="match_count_spoken">Match %1$d of %2$d</string>
    <string name="no_matches">No matches</string>
    <string name="page_indicator">%1$d/%2$d</string>
    <!-- Spoken form, for the same reason match_count has one: a screen reader reads
         "12/357" as a fraction -->
    <string name="page_indicator_spoken">Page %1$d of %2$d</string>
    <!-- The same readout over a folder's photos, which are swiped through rather than paged -->
    <string name="photo_indicator_spoken">Photo %1$d of %2$d</string>
    <string name="go_to_page">Go to page</string>
    <!-- Turns the page itself dark, which the phone's own dark mode deliberately does
         not: a document is paper and stays white at midnight. Named for what it is for
         rather than what it does, because "invert" describes the arithmetic and this is
         the only place in the app a reader meets it. -->
    <string name="night_mode">Night mode</string>
    <!-- Under the name of a file of no known format that reads as text, and so opened as
         text with no card to say why. What was done comes first: at a font size above 1.19 a
         360dp bar has no room for the whole line, and it is the end that gets cut. Issue #51. -->
    <string name="unknown_shown_as_text">Shown as text, unknown format</string>
    <!-- Under the name of a PDF in the simple view, on a phone whose WebView pdf.js can't run
         on: its pages are pictures, so there is no text to search, and the renderer draws no
         filled-in form fields, and draws highlights and comments only from Android 15. -->
    <string name="simple_view_line">Simple view: no search, notes or form entries</string>
    <string name="simple_view_line_notes">Simple view: no search or form entries</string>
    <string name="page_number">Page number</string>
    <string name="page_range">1 to %1$d</string>
    <string name="page_out_of_range">Enter a page between 1 and %1$d</string>
    <string name="go">Go</string>
    <!-- What the readout says while the thumb is dragged through anything that is not
         a PDF, where nothing else knows how far in you are -->
    <string name="scroll_position">%1$d%%</string>
    <string name="scroll_position_spoken">%1$d percent through the document</string>
    <!-- A book has no pages, so its readout says how far through it the reader is, in the
         same figures as the line above. A screen reader says the sign as "percent". -->
    <string name="book_position_spoken">%1$d%% through the book</string>
    <string name="contents">Contents</string>
    <string name="text_size">Text size</string>
    <!-- The two buttons show a small and a large letter. A screen reader says these. -->
    <string name="text_smaller">Smaller text</string>
    <string name="text_larger">Larger text</string>
    <string name="text_smaller_label" translatable="false">A\u2212</string>
    <string name="text_larger_label" translatable="false">A+</string>
    <string name="text_size_spoken">Text size %1$d%%</string>
    <string name="done">Done</string>
    <!-- The one kind of notification Gander posts, named in the phone's settings for the app:
         play and pause on the lock screen while a track plays on with the screen off -->
    <string name="audio_controls_channel">Audio controls</string>
    <!-- Non-breaking spaces keep the menu path on one line, so "Gander." never wraps alone -->
    <string name="open_with_hint">Tip: in your file manager, tap any file and choose Open\u00A0with\u00A0&gt;\u00A0Gander.</string>
    <string name="back">Back</string>
    <string name="about_gander">About Gander</string>
    <!-- The two home menu items above About Gander. That one already names the app, so
         these stay short and start with a verb. Rate appears where Google Play installed
         the copy, and Switch to Google Play takes its place anywhere else. -->
    <string name="rate_app">Rate</string>
    <string name="switch_to_play">Switch to Google Play</string>
    <string name="share_app">Share</string>
    <!-- What Share hands over. The link is the site rather than the Play listing, so it
         works for whoever receives it, however they install. -->
    <string name="share_app_text">Gander, an offline file viewer for Android: %1$s</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_permissions_label">Permissions this app requests</string>
    <string name="about_permissions_none">None</string>
    <!-- Sits under the permission line, which Gander reads back from Android at
         runtime rather than asserting for itself -->
    <string name="about_permissions_detail">Asked of Android just now, not written here in advance. Gander has no internet permission either, so it cannot send your files anywhere.</string>
    <string name="about_file_types">File types</string>
    <string name="about_file_types_detail">Every format Gander opens, by kind</string>
