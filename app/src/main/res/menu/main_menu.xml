<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Folder actions: visible only when browsing inside a folder -->
    <item
        android:id="@+id/action_sort"
        android:title="@string/sort_by"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_filter"
        android:title="@string/filter"
        android:visible="false"
        app:showAsAction="never" />
    <!-- A folder's photos picked to delete together, issue #75: Select photos where the folder
         has photos Android can move to its bin, and the bin while some are being picked. -->
    <item
        android:id="@+id/action_select"
        android:title="@string/select_photos"
        android:visible="false"
        app:showAsAction="never" />
    <!-- Whether Delete deletes for good rather than moving to Android's bin, issue #75. Shown
         wherever Delete can be used in a folder, so it can be seen and changed just before. -->
    <item
        android:id="@+id/action_delete_for_good"
        android:checkable="true"
        android:title="@string/delete_for_good"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete"
        android:icon="@drawable/ic_delete"
        android:title="@string/delete_photo"
        android:visible="false"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="ifRoom" />

    <!-- Rate on a copy Google Play installed, the only install a rating can come from.
         Any other copy gets Switch to Google Play here instead: a copy from GitHub is
         signed with the same key as Play's, so its listing offers Update and moves it
         over in place. Both open the listing; MainActivity.installedFromPlay picks the
         title. -->
    <item
        android:id="@+id/action_play"
        android:title="@string/switch_to_play"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_share_app"
        android:title="@string/share_app"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_about"
        android:title="@string/about_gander"
        app:showAsAction="never" />
</menu>
