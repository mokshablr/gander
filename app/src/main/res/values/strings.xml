<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Gander</string>
    <!-- The long form, kept for the About dialog, which is where someone who wants the
         detail goes looking. The first run gets welcome_headline instead. -->
    <string name="main_subtitle">Open and view documents, spreadsheets, slides and photos. Everything renders on your phone, nothing is uploaded.</string>
    <!-- The site's own h1, docs/index.html -->
    <string name="welcome_headline">Take a gander at any file.</string>
    <!-- The strongest sentence in the product, which used to be a clause in the middle of
         main_subtitle. The second half is checkable: the About dialog reads the permission
         list back out of Android rather than asserting it. -->
    <string name="welcome_promise">Nothing is uploaded. Gander has no internet permission.</string>
    <!-- Spoken form of the badge grid. The tiles themselves are not important for
         accessibility, so this is the whole announcement and it is one stop rather than
         nine, the same way a file row carries the description for its own four views. -->
    <string name="welcome_formats_spoken">Opens PDFs, Word documents, Excel spreadsheets, PowerPoint slides, images, video, audio, Markdown and text files.</string>
    <string name="open_a_file">Open a file</string>
    <string name="recent_files">Recent files</string>
    <string name="folders">Folders</string>
    <string name="add_folder">Add a folder</string>
    <string name="no_recents_hint">Files you open appear here for quick access.</string>
    <string name="no_folders_hint">Grant a folder to browse its files right here. Gander needs no storage permission to do it.</string>
    <string name="empty_folder">Nothing to show in this folder.</string>
    <string name="removed">Removed</string>
    <!-- Releasing a folder grant is the one thing on this screen that cannot be undone:
         Android has no way to re-take a released permission, so the reader would have to
         walk the system picker again. Hence the only confirmation in the app. -->
    <string name="remove_folder_title">Remove folder?</string>
    <string name="remove_folder_message">Gander will lose access to %1$s. Granting it back means finding it in the system picker again.</string>
    <!-- Also the TalkBack label for the long-press that removes a row -->
    <string name="remove">Remove</string>
    <string name="search_in_document">Search in document</string>
    <string name="share_file">Share</string>
    <string name="show_in_file_manager">Show in file manager</string>
    <string name="no_file_manager">No app can open this folder</string>
    <string name="share_failed">This file can\'t be shared</string>
    <string name="previous_match">Previous match</string>
    <string name="next_match">Next match</string>
    <string name="close_search">Close search</string>
    <string name="match_count">%1$d/%2$d</string>
    <!-- Spoken form: screen readers read "2/7" as "two sevenths" -->
    <string name="match_count_spoken">Match %1$d of %2$d</string>
    <string name="no_matches">No matches</string>
    <string name="page_indicator">%1$d/%2$d</string>
    <!-- Spoken form, for the same reason match_count has one: a screen reader reads
         "12/357" as a fraction -->
    <string name="page_indicator_spoken">Page %1$d of %2$d</string>
    <string name="go_to_page">Go to page</string>
    <!-- Turns the page itself dark, which the phone's own dark mode deliberately does
         not: a document is paper and stays white at midnight. Named for what it is for
         rather than what it does, because "invert" describes the arithmetic and this is
         the only place in the app a reader meets it. -->
    <string name="night_mode">Night mode</string>
    <string name="page_number">Page number</string>
    <string name="page_range">1 to %1$d</string>
    <string name="page_out_of_range">Enter a page between 1 and %1$d</string>
    <string name="go">Go</string>
    <!-- What the readout says while the thumb is dragged through anything that is not
         a PDF, where nothing else knows how far in you are -->
    <string name="scroll_position">%1$d%%</string>
    <string name="scroll_position_spoken">%1$d percent through the document</string>
    <string name="open_with_hint">Tip: in your file manager, tap any file and choose Open with &gt; Gander.</string>
    <string name="back">Back</string>
    <string name="about_gander">About Gander</string>
    <!-- The two home menu items above About Gander. That one already names the app, so
         these stay a bare verb each. Rate only appears where Google Play installed it. -->
    <string name="rate_app">Rate</string>
    <string name="share_app">Share</string>
    <!-- What Share hands over. The link is the site rather than the Play listing, so it
         works for whoever receives it, however they install. -->
    <string name="share_app_text">Gander, an offline file viewer for Android: %1$s</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_permissions_label">Permissions this app requests</string>
    <string name="about_permissions_none">None</string>
    <!-- Sits under the permission line, which Gander reads back from Android at
         runtime rather than asserting for itself -->
    <string name="about_permissions_detail">Asked of Android just now, not written here in advance. Gander has no internet permission either, so it cannot send your files anywhere.</string>
    <string name="about_made_by">Made by Arjun Maniyani</string>
    <string name="about_made_by_url" translatable="false">arjun.maniyani.com</string>
    <string name="about_source">Source code</string>
    <string name="about_source_url" translatable="false">github.com/mokshablr/gander</string>
    <string name="about_licences">Open source licences</string>
    <string name="about_licences_detail">Full text for every bundled library</string>
    <string name="about_copyright" translatable="false">MIT licence. Copyright © 2026 Arjun Maniyani.</string>
    <string name="about_close">Close</string>
    <string name="no_browser">No app can open links</string>
    <!-- Becomes the viewer's title, so it reads as the document it is -->
    <string name="licences_file_name" translatable="false">Open source licences.md</string>
    <string name="licences_failed">The licences file can\'t be opened</string>
    <!-- Shown where the document was, after Android takes the renderer process
         away. Two titles because the two causes are not the same thing: the
         common one is the system reclaiming memory, which is nobody's fault and
         says nothing about the file, and the rare one is the renderer failing. -->
    <string name="render_gone_reclaimed">Android closed this document to free up memory</string>
    <string name="render_gone_crashed">The document viewer stopped unexpectedly</string>
    <string name="render_gone_detail">The file itself is untouched. Reloading it usually works.</string>
    <string name="render_gone_reload">Reload</string>
    <string name="save_copy">Save a copy</string>
    <string name="save_copy_done">Copy saved</string>
    <string name="save_copy_failed">The copy could not be saved</string>
    <string name="url_author" translatable="false">https://arjun.maniyani.com/</string>
    <string name="url_source" translatable="false">https://github.com/mokshablr/gander</string>
    <string name="url_site" translatable="false">https://arjun.maniyani.com/gander/</string>
    <!-- Only reached when the Play Store app will not open the listing itself -->
    <string name="url_play_listing" translatable="false">https://play.google.com/store/apps/details?id=%1$s</string>
</resources>
