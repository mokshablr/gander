<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         Every role, not one.

         Setting colorPrimary alone left the other thirty-four resolving to Material's
         baseline theme, which is purple, so the FAB, the surfaces and every container
         role were a colour that appears nowhere else in this project. The names below
         are defined twice, in values/colors.xml and values-night/colors.xml, so this
         list is written once and night mode follows on its own.

         windowBackground is here as well as colorBackground so the warm ground reaches
         behind the list rather than showing through as the platform default.
    -->
    <style name="Theme.Gander" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gander_primary</item>
        <item name="colorOnPrimary">@color/gander_on_primary</item>
        <item name="colorPrimaryContainer">@color/gander_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/gander_on_primary_container</item>
        <item name="colorSecondary">@color/gander_secondary</item>
        <item name="colorOnSecondary">@color/gander_on_secondary</item>
        <item name="colorSecondaryContainer">@color/gander_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/gander_on_secondary_container</item>
        <item name="colorTertiary">@color/gander_tertiary</item>
        <item name="colorOnTertiary">@color/gander_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/gander_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/gander_on_tertiary_container</item>
        <item name="colorError">@color/gander_error</item>
        <item name="colorOnError">@color/gander_on_error</item>
        <item name="colorErrorContainer">@color/gander_error_container</item>
        <item name="colorOnErrorContainer">@color/gander_on_error_container</item>
        <item name="colorSurface">@color/gander_surface</item>
        <item name="colorOnSurface">@color/gander_on_surface</item>
        <item name="colorOnBackground">@color/gander_on_surface</item>
        <item name="colorSurfaceVariant">@color/gander_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/gander_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/gander_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/gander_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/gander_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/gander_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/gander_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/gander_surface_dim</item>
        <item name="colorSurfaceBright">@color/gander_surface_bright</item>
        <item name="colorOutline">@color/gander_outline</item>
        <item name="colorOutlineVariant">@color/gander_outline_variant</item>
        <item name="colorSurfaceInverse">@color/gander_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/gander_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/gander_inverse_primary</item>
        <item name="android:colorBackground">@color/gander_surface</item>
        <item name="android:windowBackground">@color/gander_surface</item>
        <item name="android:textColorHighlight">@color/gander_text_highlight</item>
        <item name="android:windowLightStatusBar">@bool/gander_light_status_bar</item>
        <!-- The status bar itself, on Android 14 and older, where the app colours it. With
             nothing named here the platform used colorPrimaryDark, which Material 3 sets to
             colorPrimary: the brand red under the dark icons asked for above, and a pale pink
             under white ones at night. From Android 15 the app is drawn beneath the bar, which
             already shows the surface there, so this changes nothing on those phones. Seen in
             a screenshot on #30. -->
        <item name="android:statusBarColor">@color/gander_surface</item>
    </style>

    <!-- The viewer's overflow menu in the app's night colours, on a phone set to light.
         NightChrome.kt lays this over the toolbar's theme when PDF night mode goes on, and lays
         Theme.Gander back over it when it goes off. The menu is built again each time it opens
         and reads these then. They are the roles it draws with, the container and the night
         mode checkbox, and its text, which Material's light theme sets to a grey of its own
         rather than to a role: the light theme's inverse text is the grey its night theme uses,
         so that is what a phone set to dark shows. -->
    <style name="ThemeOverlay.Gander.Menu.Night" parent="">
        <item name="colorSurfaceContainer">@color/gander_night_surface_container</item>
        <item name="colorOnSurface">@color/gander_night_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/gander_night_on_surface_variant</item>
        <item name="colorPrimary">@color/gander_night_primary</item>
        <item name="colorOnPrimary">@color/gander_night_on_primary</item>
        <item name="android:textColorPrimary">?android:attr/textColorPrimaryInverse</item>
    </style>

    <style name="ShapeAppearance.Gander.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- About dialog. Body text is inset to the dialog's own 24dp gutter; the
         tappable rows run full bleed so the ripple reaches both edges. Every
         style sets parent="" so the dotted names do not inherit each other. -->
    <style name="Widget.Gander.About.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Widget.Gander.About.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.Gander.About.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Gander.About.Row.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Gander.About.Row.Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
